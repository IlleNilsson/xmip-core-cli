<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The executable's tests (ADR-0052 clauses 5 and 6): argument parsing, the
    text and JSON renderings over a fake operator surface, and which runtime
    library wins when several are named. What crosses the C ABI is the
    binding's to test; only the audit records through the runtime's library,
    which Xmip.Abi copies beside these tests (ADR-0062).

    Target framework and the rest come from Directory.Build.props.
  -->

  <PropertyGroup>
    <RootNamespace>Xmip.Cli.Test</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3: a test project is its own executable. `dotnet test`
         drives it through VSTest and xunit.runner.visualstudio, the way
         the estate's tooling calls it (Test-XmipDotnetModule); xunit.v3 4
         would otherwise make it a Microsoft.Testing.Platform application,
         which the .NET 10 and later SDK refuses under VSTest. -->
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>

    <!-- Test classes are public for the runner, not for a reader. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xmip.Cli\Xmip.Cli.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test cluster's names, read by the one helper every .NET test
         shares (ADR-0056, amendment 2026-10-03). -->
    <Compile Include="..\..\..\..\..\foundation\abi\dotnet\Xmip.Surface.Test\TestCluster.cs"
             Link="TestCluster.cs" />
    <Using Include="Xmip.Surface.Test" />
  </ItemGroup>

</Project>
