<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The xmip executable (ADR-0014 clause 8; ADR-0052 clause 5). Argument
    parsing and rendering over the shared surface library; nothing here
    crosses the C ABI on its own, and nothing here links Xmip's Rust.

    Target framework and the rest come from Directory.Build.props.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Xmip.Cli</RootNamespace>
    <!-- xmip-cli, not xmip: every System Process Xmip owns matches xmip-*, the
         executable included, so a forgotten follow session is found and
         stopped with the rest (ADR-0053; the owner, 2026-09-18). -->
    <AssemblyName>xmip-cli</AssemblyName>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- The C ABI, bound once, and the model every .NET surface shares. Both
         live in xmip-core-abi — the binding by ADR-0014's amendment of
         2026-09-09, the surface library by ADR-0052 clause 1 — and every
         surface references them by path inside the composed estate, four
         levels up from this project. Siblings, not vendored. -->
    <ProjectReference Include="..\..\..\..\foundation\abi\dotnet\Xmip.Abi\Xmip.Abi.csproj" />
    <ProjectReference Include="..\..\..\..\foundation\abi\dotnet\Xmip.Surface\Xmip.Surface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The surface a command reads is stated here, beside the executable,
         never guessed (ADR-0052 clause 3). -->
    <None Update="xmip.cli.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
