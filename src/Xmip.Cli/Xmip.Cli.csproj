<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Xmip.Cli</RootNamespace>
    <AssemblyName>xmip</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- An operator surface reports identifiers, status codes and module
         names. None of that is locale-dependent, and pulling ICU in for it
         costs 30 MB in a self-contained build. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- The C ABI, bound once. Xmip.Abi in xmip-core-abi declares the two
         headers for every surface — this one, the PowerShell module and the
         GUI — so nothing here crosses the boundary on its own (ADR-0014,
         amendment of 2026-08-26). A sibling in the estate, not vendored: the
         path is the estate's layout, four levels up from this project. -->
    <ProjectReference Include="..\..\..\..\foundation\abi\dotnet\Xmip.Abi\Xmip.Abi.csproj" />
  </ItemGroup>

</Project>
